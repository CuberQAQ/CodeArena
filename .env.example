# ===========================================
# Code Arena - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# ---- Application ----
APP_NAME=Code Arena
DEBUG=false

# ---- Database (PostgreSQL) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=code_arena
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/code_arena

# ---- Codeforces API ----
CF_API_BASE_URL=https://codeforces.com/api

# ---- JWT Authentication ----
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ---- Frontend ----
FRONTEND_URL=http://localhost:5173
FRONTEND_PORT=80
VITE_API_BASE_URL=http://localhost:8000

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
