# ===========================================
# Code Arena - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
#
# Required variables (must be set before deployment):
#   - POSTGRES_PASSWORD
#   - JWT_SECRET
# ===========================================

# ---- Application ----
APP_NAME=Code Arena
DEBUG=false

# ---- Database (PostgreSQL) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=code_arena
DB_PORT=5432
# Full connection URL (used by backend service)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_TO_A_STRONG_PASSWORD@db:5432/code_arena

# ---- Codeforces API ----
CF_API_BASE_URL=https://codeforces.com/api

# ---- JWT Authentication ----
# IMPORTANT: Generate a secure secret for production!
#   Option 1: python -c "import secrets; print(secrets.token_urlsafe(48))"
#   Option 2: openssl rand -hex 48
#   Option 3: head -c 64 /dev/urandom | base64
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ---- CORS ----
# Comma-separated list of allowed origins
# In production, set this to your domain (e.g., https://code-arena.example.com)
CORS_ORIGINS=http://localhost,http://localhost:80

# ---- Frontend ----
FRONTEND_URL=http://localhost
FRONTEND_PORT=80
# This is used at build time by Vite (passed during docker build)
VITE_API_BASE_URL=

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---- Redis ----
# Format: redis://<host>:<port>/<db>
REDIS_URL=redis://redis:6379/0

# ---- Gunicorn (Production Only) ----
# Number of worker processes. Recommended: (2 x CPU cores) + 1
GUNICORN_WORKERS=4

# ---- Logging ----
# Log level: debug, info, warning, error, critical
LOG_LEVEL=info
