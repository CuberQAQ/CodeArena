FROM python:3.12-slim AS base

# Install system deps: curl (healthcheck) + Playwright Chromium deps
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd --gid 1000 appuser && \
    useradd --uid 1000 --gid appuser --shell /bin/bash --create-home appuser

WORKDIR /app

# 1) Install Python production dependencies (layer cached unless requirements-prod.txt changes)
COPY backend/requirements-prod.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# 2) Install Playwright + Chromium to a shared location accessible by appuser
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN pip install --no-cache-dir playwright>=1.50.0 && \
    playwright install chromium --with-deps && \
    playwright install-deps chromium && \
    chown -R appuser:appuser /opt/ms-playwright

# 3) Copy application code (changes most often — last layer)
COPY backend/ .

# Change ownership to non-root user
RUN chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

# Production: Gunicorn with Uvicorn workers
CMD gunicorn app.main:app \
     --workers ${GUNICORN_WORKERS:-4} \
     --worker-class uvicorn.workers.UvicornWorker \
     --bind :8000 \
     --timeout 120 \
     --graceful-timeout 30 \
     --access-logfile - \
     --error-logfile - \
     --log-level ${LOG_LEVEL:-info}
